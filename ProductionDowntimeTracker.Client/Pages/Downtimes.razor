@page "/downtimes"
@using ProductionDowntimeTracker.Client.Models
@inject HttpClient Http

<PageTitle>Prostoje</PageTitle>

<h1>Evidence prostojů</h1>

<h3>Zahájit nový prostoj</h3>

<EditForm Model="@newDowntime" OnValidSubmit="@StartDowntimeAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="machineId" class="form-label">Stroj</label>

        <InputSelect id="machineId"
                     class="form-select"
                     @bind-Value="newDowntime.MachineId">
            <option value="0">-- Vyberte stroj --</option>

            @if (machines is not null)
            {
                @foreach (MachineDto machine in machines)
                {
                    <option value="@machine.Id">@machine.Name</option>
                }
            }
        </InputSelect>

        <ValidationMessage For="@(() => newDowntime.MachineId)"
                           class="text-danger" />
    </div>

    <button type="submit" class="btn btn-primary">
        Zahájit prostoj
    </button>
</EditForm>

<hr />

@if (errorMessage is not null)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}
else if (downtimeRecords is null)
{
    <p>Načítání prostojů...</p>
}
else if (downtimeRecords.Count == 0)
{
    <p>Zatím nejsou evidovány žádné prostoje.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Stroj</th>
                <th>Kategorie</th>
                <th>Detail</th>
                <th>Začátek</th>
                <th>Konec</th>
                <th>Délka</th>
                <th>Stav</th>
                <th>Akce</th>
            </tr>
        </thead>

        <tbody>
            @foreach (DowntimeRecordDto record in downtimeRecords)
            {
                <tr>
                    <td>@record.Id</td>
                    <td>@GetMachineName(record.MachineId)</td>
                    <td>@GetCategoryName(record.CategoryId)</td>

                    <td>
                        @(string.IsNullOrWhiteSpace(record.Detail)
                            ? "—"
                            : record.Detail)
                    </td>
                    <td>@record.StartTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @(record.EndTime.HasValue
                            ? record.EndTime.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            : "—")
                    </td>
                    <td>@GetDuration(record)</td>
                    <td>
                        @(record.EndTime.HasValue ? "Ukončený" : "Probíhá")
                    </td>
                    <td>
                        @if (!record.EndTime.HasValue)
                        {
                            <button type="button"
                                    class="btn btn-success btn-sm"
                                    @onclick="() => OpenStopDialog(record.Id)">
                                Ukončit prostoj
                            </button>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

@if (downtimeIdToStop.HasValue)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="stopDowntimeTitle">

        <div class="modal-dialog modal-dialog-centered"
             role="document">

            <EditForm Model="@stopDowntime"
                      OnValidSubmit="@ConfirmStopDowntimeAsync"
                      class="modal-content">

                <DataAnnotationsValidator />

                <div class="modal-header">
                    <h5 class="modal-title"
                        id="stopDowntimeTitle">
                        Ukončit prostoj
                    </h5>

                    <button type="button"
                            class="btn-close"
                            aria-label="Zavřít"
                            disabled="@isStopping"
                            @onclick="CloseStopDialog">
                    </button>
                </div>

                <div class="modal-body">
                    @if (stopErrorMessage is not null)
                    {
                        <div class="alert alert-danger">
                            @stopErrorMessage
                        </div>
                    }

                    <div class="mb-3">
                        <label for="stopCategory"
                               class="form-label">
                            Kategorie
                        </label>

                        <InputSelect id="stopCategory"
                                     class="form-select"
                                     @bind-Value="stopDowntime.CategoryId">

                            <option value="0">
                                -- Vyberte kategorii --
                            </option>

                            @if (categories is not null)
                            {
                                @foreach (DowntimeCategoryDto category in categories)
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }
                            }
                        </InputSelect>

                        <ValidationMessage For="@(() => stopDowntime.CategoryId)"
                                           class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="stopDetail"
                               class="form-label">
                            Detail prostoje
                        </label>

                        <InputTextArea id="stopDetail"
                                       class="form-control"
                                       rows="4"
                                       maxlength="500"
                                       @bind-Value="stopDowntime.Detail" />

                        <ValidationMessage For="@(() => stopDowntime.Detail)"
                                           class="text-danger" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@isStopping"
                            @onclick="CloseStopDialog">
                        Zrušit
                    </button>

                    <button type="submit"
                            class="btn btn-success"
                            disabled="@isStopping">
                        @(isStopping
                            ? "Ukončuji..."
                            : "Ukončit prostoj")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

}

@code {
    private List<DowntimeRecordDto>? downtimeRecords;
    private string? errorMessage;
    private List<MachineDto>? machines;
    private List<DowntimeCategoryDto>? categories;
    private StartDowntimeRequestDto newDowntime = new();
    private StopDowntimeRequestDto stopDowntime = new();
    private int? downtimeIdToStop;
    private string? stopErrorMessage;
    private bool isStopping;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            downtimeRecords =
                await Http.GetFromJsonAsync<List<DowntimeRecordDto>>(
                    "api/DowntimeRecords");

            machines =
                await Http.GetFromJsonAsync<List<MachineDto>>(
                    "api/Machines");

            categories =
                await Http.GetFromJsonAsync<List<DowntimeCategoryDto>>(
                    "api/DowntimeCategories");
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Prostoje se nepodařilo načíst: {ex.Message}";
        }
    }

    private string GetMachineName(int machineId)
    {
        MachineDto? machine =
            machines?.FirstOrDefault(machine => machine.Id == machineId);

        return machine?.Name ?? $"Neznámý stroj (ID {machineId})";
    }

    private string GetCategoryName(int? categoryId)
    {
        if (!categoryId.HasValue)
        {
            return "—";
        }

        DowntimeCategoryDto? category =
            categories?.FirstOrDefault(
                item => item.Id == categoryId.Value);

        return category?.Name
            ?? $"Neznámá kategorie (ID {categoryId.Value})";
    }

    private void OpenStopDialog(int id)
    {
        downtimeIdToStop = id;
        stopDowntime = new StopDowntimeRequestDto();
        stopErrorMessage = null;
    }

    private void CloseStopDialog()
    {
        downtimeIdToStop = null;
        stopDowntime = new StopDowntimeRequestDto();
        stopErrorMessage = null;
    }

    private async Task StartDowntimeAsync()
    {
        try
        {
            errorMessage = null;

            HttpResponseMessage response =
                await Http.PostAsJsonAsync(
                    "api/DowntimeRecords/start",
                    newDowntime);

            response.EnsureSuccessStatusCode();

            downtimeRecords =
                await Http.GetFromJsonAsync<List<DowntimeRecordDto>>(
                    "api/DowntimeRecords");

            newDowntime = new StartDowntimeRequestDto();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Prostoj se nepodařilo zahájit: {ex.Message}";
        }
    }

    private async Task ConfirmStopDowntimeAsync()
    {
        if (!downtimeIdToStop.HasValue)
        {
            return;
        }

        try
        {
            isStopping = true;
            stopErrorMessage = null;

            HttpResponseMessage response =
                await Http.PutAsJsonAsync(
                    $"api/DowntimeRecords/{downtimeIdToStop.Value}/stop",
                    stopDowntime);

            if (!response.IsSuccessStatusCode)
            {
                string responseMessage =
                    await response.Content.ReadAsStringAsync();

                stopErrorMessage =
                    string.IsNullOrWhiteSpace(responseMessage)
                        ? $"API vrátilo chybu {(int)response.StatusCode}."
                        : responseMessage;

                return;
            }

            downtimeRecords =
                await Http.GetFromJsonAsync<List<DowntimeRecordDto>>(
                    "api/DowntimeRecords");

            CloseStopDialog();
        }
        catch (Exception ex)
        {
            stopErrorMessage =
                $"Prostoj se nepodařilo ukončit: {ex.Message}";
        }
        finally
        {
            isStopping = false;
        }
    }


    private string GetDuration(DowntimeRecordDto record)
    {
        if (!record.EndTime.HasValue)
        {
            return "Probíhá";
        }

        TimeSpan duration =
            record.EndTime.Value - record.StartTime;

        int totalMinutes = (int)duration.TotalMinutes;

        return $"{totalMinutes} min";
    }
}